{
  "id": "FLOW_COMPETITION_RESEARCH",
  "type": "flow",
  "name": "一年内竞赛调研选型流程",
  "params": [
    { "name": "grade", "type": "String" },
    { "name": "motive", "type": "String" },
    { "name": "skills", "type": "String" },
    { "name": "hours", "type": "String" },
    { "name": "note", "type": "String" }
  ],
  "results": [
    { "name": "primaryCompetitions", "type": "String" },
    { "name": "backupCompetitions", "type": "String" },
    { "name": "rulePrimary", "type": "String" },
    { "name": "ruleBackup", "type": "String" },
    { "name": "goalType", "type": "String" },
    { "name": "profileJson", "type": "String" },
    { "name": "explanation", "type": "String" },
    { "name": "llmUsed", "type": "Integer" },
    { "name": "adjusted", "type": "Integer" },
    { "name": "catalogWindow", "type": "String" }
  ],
  "nodes": [
    {
      "id": "BUILD_PROFILE",
      "type": "event",
      "name": "构建选手画像",
      "reference": "COMP_BUILD_PROFILE",
      "params": [
        { "name": "grade", "type": "String" },
        { "name": "motive", "type": "String" },
        { "name": "skills", "type": "String" },
        { "name": "hours", "type": "String" },
        { "name": "note", "type": "String" }
      ],
      "results": [
        { "name": "profileJson", "type": "String" },
        { "name": "goalType", "type": "String" },
        { "name": "grade", "type": "String" },
        { "name": "motive", "type": "String" },
        { "name": "skills", "type": "String" },
        { "name": "hours", "type": "String" },
        { "name": "note", "type": "String" },
        { "name": "llmEnabled", "type": "Integer" }
      ]
    },
    {
      "id": "LOAD_RULES",
      "type": "event",
      "name": "读取认定表与推免计分办法",
      "reference": "COMP_LOAD_RULES",
      "params": [],
      "results": [
        { "name": "rulesReady", "type": "Integer" },
        { "name": "catalogWindow", "type": "String" }
      ]
    },
    {
      "id": "FILTER_COLLEGE",
      "type": "event",
      "name": "过滤学院认可赛事",
      "reference": "COMP_FILTER_COLLEGE",
      "params": [{ "name": "goalType", "type": "String" }],
      "results": [{ "name": "candidatePool", "type": "String" }]
    },
    {
      "id": "FILTER_TIME",
      "type": "event",
      "name": "一年时间窗口过滤",
      "reference": "COMP_FILTER_TIME",
      "params": [{ "name": "candidatePool", "type": "String" }],
      "results": [{ "name": "timeWindowPool", "type": "String" }]
    },
    {
      "id": "EVAL_CLASS1",
      "type": "event",
      "name": "评估Ⅰ类高价值赛",
      "reference": "COMP_EVAL_CLASS1",
      "params": [{ "name": "timeWindowPool", "type": "String" }],
      "results": [{ "name": "class1Pick", "type": "String" }]
    },
    {
      "id": "EVAL_SYSTEM",
      "type": "event",
      "name": "评估系统能力赛道",
      "reference": "COMP_EVAL_SYSTEM",
      "params": [{ "name": "timeWindowPool", "type": "String" }],
      "results": [{ "name": "systemPick", "type": "String" }]
    },
    {
      "id": "EVAL_ALGO",
      "type": "event",
      "name": "评估程序设计赛道",
      "reference": "COMP_EVAL_ALGO",
      "params": [{ "name": "timeWindowPool", "type": "String" }],
      "results": [{ "name": "algoPick", "type": "String" }]
    },
    {
      "id": "EVAL_MODEL",
      "type": "event",
      "name": "评估建模与创新赛道",
      "reference": "COMP_EVAL_MODEL",
      "params": [{ "name": "timeWindowPool", "type": "String" }],
      "results": [{ "name": "modelPick", "type": "String" }]
    },
    {
      "id": "RANK_OUTPUT",
      "type": "event",
      "name": "规则排序保底名单",
      "reference": "COMP_RANK_OUTPUT",
      "params": [
        { "name": "goalType", "type": "String" },
        { "name": "class1Pick", "type": "String" },
        { "name": "systemPick", "type": "String" },
        { "name": "algoPick", "type": "String" },
        { "name": "modelPick", "type": "String" },
        { "name": "grade", "type": "String" },
        { "name": "motive", "type": "String" },
        { "name": "skills", "type": "String" },
        { "name": "hours", "type": "String" }
      ],
      "results": [
        { "name": "rulePrimary", "type": "String" },
        { "name": "ruleBackup", "type": "String" },
        { "name": "primaryCompetitions", "type": "String" },
        { "name": "backupCompetitions", "type": "String" }
      ]
    },
    {
      "id": "LLM_ADJUST",
      "type": "event",
      "name": "LLM调整推荐",
      "reference": "COMP_LLM_ADJUST",
      "params": [
        { "name": "profileJson", "type": "String" },
        { "name": "goalType", "type": "String" },
        { "name": "rulePrimary", "type": "String" },
        { "name": "ruleBackup", "type": "String" }
      ],
      "results": [
        { "name": "primaryCompetitions", "type": "String" },
        { "name": "backupCompetitions", "type": "String" },
        { "name": "explanation", "type": "String" },
        { "name": "llmUsed", "type": "Integer" },
        { "name": "adjusted", "type": "Integer" },
        { "name": "rulePrimary", "type": "String" },
        { "name": "ruleBackup", "type": "String" }
      ]
    }
  ],
  "routes": [
    { "source": "start", "target": "BUILD_PROFILE" },
    { "source": "BUILD_PROFILE", "target": "LOAD_RULES" },
    { "source": "LOAD_RULES", "target": "FILTER_COLLEGE" },
    { "source": "FILTER_COLLEGE", "target": "FILTER_TIME" },
    { "source": "FILTER_TIME", "target": "EVAL_CLASS1" },
    { "source": "FILTER_TIME", "target": "EVAL_SYSTEM" },
    { "source": "FILTER_TIME", "target": "EVAL_ALGO" },
    { "source": "FILTER_TIME", "target": "EVAL_MODEL" },
    { "source": "EVAL_CLASS1", "target": "RANK_OUTPUT" },
    { "source": "EVAL_SYSTEM", "target": "RANK_OUTPUT" },
    { "source": "EVAL_ALGO", "target": "RANK_OUTPUT" },
    { "source": "EVAL_MODEL", "target": "RANK_OUTPUT" },
    { "source": "RANK_OUTPUT", "target": "LLM_ADJUST" },
    { "source": "LLM_ADJUST", "target": "end" }
  ],
  "strategies": [
    { "source": "FILTER_TIME", "strategy": "all" },
    { "target": "RANK_OUTPUT", "strategy": "close" }
  ]
}
