      "results": [
        { "name": "i", "type": "Integer" },
        { "name": "sum", "type": "Integer" },
        { "name": "times", "type": "Integer" }
      ]
    }
  ],
  "routes": [
    { "source": "start", "target": "FLOW_LOOP_DO_WHILE_INIT" },
    { "source": "FLOW_LOOP_DO_WHILE_INIT", "target": "FLOW_LOOP_DO_WHILE_NODE" },
    { "source": "FLOW_LOOP_DO_WHILE_NODE", "target": "end" }
  ]
